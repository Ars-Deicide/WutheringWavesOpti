# Copy to `.env` and fill in. `.env` is gitignored — never commit your token.

# Required: your Discord bot token (Discord Developer Portal → Bot → Reset Token)
DISCORD_TOKEN=

# Optional: source for transparent character art shown in /build.
# A folder/CDN of PNGs named by slug, e.g. ".../jiyan.png", ".../rover-havoc.png".
# Leave unset to render embeds without portraits.
# WUWA_IMAGE_BASE=https://cdn.example.com/wuwa/portraits
# WUWA_IMAGE_EXT=png
